# Absolute origin of the deployed site — canonical URLs, hreflang, sitemap, OG tags.
# On Vercel this falls back to the project's production domain if left unset.
NEXT_PUBLIC_SITE_URL=https://voizaudio.com

# Contact form delivery (https://resend.com). Without all three the form still
# accepts submissions and logs them, but no email is sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@voizaudio.com
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=site@voizaudio.com

# Supabase — projects and tags managed from /admin. Project Settings → API Keys
# (use the *publishable* key, never the secret one). Without these the site
# renders with no projects and /admin explains what is missing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Protects /api/keep-alive, the daily cron that stops a free Supabase project
# from pausing. Any long random string; Vercel sends it to the cron automatically.
CRON_SECRET=
