# Absolute origin of the deployed site — canonical URLs, hreflang, sitemap, OG tags.
# On Vercel this falls back to the project's production domain if left unset.
NEXT_PUBLIC_SITE_URL=https://voiz.example.com

# Contact form delivery (https://resend.com). Without all three the form still
# accepts submissions and logs them, but no email is sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@voiz.example.com
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=site@voiz.example.com
